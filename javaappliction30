package javaapplication30;


abstract class GeometricObject {
    private String color;
    private boolean filled;

    public GeometricObject(String color, boolean filled) {
        this.color = color;
        this.filled = filled;
    }

    public String getColor() { return color; }
    public void setColor(String color) { this.color = color; }
    public boolean isFilled() { return filled; }
    public void setFilled(boolean filled) { this.filled = filled; }

    public abstract double getArea();
    public abstract double getPerimeter();

    public void displayInfo() {
        System.out.println("Color: " + color);
        System.out.println("Filled: " + filled);
        System.out.println("Area: " + getArea());
        System.out.println("Perimeter: " + getPerimeter());
    }
}

// 2. كلاس الدائرة (Circle)
class Circle extends GeometricObject {
    private double radius;

    public Circle(double radius, String color, boolean filled) {
        super(color, filled);
        this.radius = radius;
    }

    @Override
    public double getArea() {
        return Math.PI * radius * radius;
    }

    @Override
    public double getPerimeter() {
        return 2 * Math.PI * radius;
    }
}

// 3. كلاس المستطيل (Rectangle)
class Rectangle extends GeometricObject {
    private double width, height;

    public Rectangle(double width, double height, String color, boolean filled) {
        super(color, filled);
        this.width = width;
        this.height = height;
    }

    @Override
    public double getArea() {
        return width * height;
    }

    @Override
    public double getPerimeter() {
        return 2 * (width + height);
    }
}

// 4. كلاس المربع (Square)
class Square extends GeometricObject {
    private double side;

    public Square(double side, String color, boolean filled) {
        super(color, filled);
        this.side = side;
    }

    @Override
    public double getArea() {
        return side * side;
    }

    @Override
    public double getPerimeter() {
        return 4 * side;
    }
}

// 5. كلاس المثلث (Triangle)
class Triangle extends GeometricObject {
    private double base, height;

    public Triangle(double base, double height, String color, boolean filled) {
        super(color, filled);
        this.base = base;
        this.height = height;
    }

    @Override
    public double getArea() {
        return 0.5 * base * height;
    }

    @Override
    public double getPerimeter() {
        return 3 * base;
    }
}

// 6. الكلاس الرئيسي للتشغيل (JavaApplication30)
public class JavaApplication30 {
    public static void main(String[] args) {
        Circle circle = new Circle(5, "Red", true);
        Rectangle rectangle = new Rectangle(4, 6, "Blue", false);
        Square square = new Square(4, "Green", true);
        Triangle triangle = new Triangle(3, 4, "Yellow", false);

        System.out.println("===== CIRCLE =====");
        circle.displayInfo();

        System.out.println("\n===== RECTANGLE =====");
        rectangle.displayInfo();

        System.out.println("\n===== SQUARE =====");
        square.displayInfo();

        System.out.println("\n===== TRIANGLE =====");
        triangle.displayInfo();
    }
}
